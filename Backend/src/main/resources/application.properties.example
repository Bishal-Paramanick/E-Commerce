spring.application.name=e-com-backend

# Server Port
server.port=8080

# Database Connection (Configure via environment variables or local profile)
spring.datasource.url=jdbc:mysql://localhost:3306/ecommerce_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
spring.datasource.username=${DB_USERNAME:root}
spring.datasource.password=${DB_PASSWORD:your_password_here}
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# Spring Data JPA / Hibernate
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=false
spring.jpa.open-in-view=true
spring.jpa.properties.hibernate.format_sql=false

# Multipart File Upload Configuration
spring.servlet.multipart.enabled=true
spring.servlet.multipart.max-file-size=10MB
spring.servlet.multipart.max-request-size=10MB

# Logging Configuration
logging.level.com.bishal.ecombackend=INFO
logging.level.org.springframework.security=WARN
logging.file.name=logs/ecom-backend.log

# Razorpay Credentials (Use environment variables)
razorpay.key.id=${RAZORPAY_KEY_ID:rzp_test_your_key_id_here}
razorpay.key.secret=${RAZORPAY_KEY_SECRET:your_key_secret_here}
razorpay.currency=INR
razorpay.webhook.secret=${RAZORPAY_WEBHOOK_SECRET:your_webhook_secret_here}

# Admin System Reset Key
admin.reset.key=${ADMIN_RESET_KEY:your_admin_reset_key_here}

# JWT Signing Key
jwt.secret=${JWT_SECRET:your_jwt_secret_here}
