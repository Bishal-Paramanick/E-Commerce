spring.application.name=e-com-backend

# Server Port
server.port=${PORT:8080}

# MySQL Database Connection
spring.datasource.url=jdbc:mysql://${DB_HOST:localhost}:${DB_PORT:3306}/${DB_NAME:defaultdb}?sslMode=REQUIRED&allowPublicKeyRetrieval=true&serverTimezone=UTC
spring.datasource.username=${DB_USERNAME:root}
spring.datasource.password=${DB_PASSWORD:secret}
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# Spring Data JPA / Hibernate
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=false
spring.jpa.open-in-view=false
spring.jpa.properties.hibernate.format_sql=true
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MySQLDialect

# Multipart File Upload Configuration
spring.servlet.multipart.enabled=true
spring.servlet.multipart.max-file-size=10MB
spring.servlet.multipart.max-request-size=10MB

# Logging Configuration
logging.level.com.bishal.ecombackend=INFO
logging.level.org.springframework.security=WARN
logging.level.org.hibernate.SQL=INFO
logging.file.name=logs/ecom-backend.log

# Razorpay Credentials
razorpay.key.id=${RAZORPAY_KEY_ID:rzp_test_xxxxxx}
razorpay.key.secret=${RAZORPAY_KEY_SECRET:xxxxxx}
razorpay.currency=INR
razorpay.webhook.secret=${RAZORPAY_WEBHOOK_SECRET:default_webhook_secret}

# Admin System Reset Key
admin.reset.key=${ADMIN_RESET_KEY:admin123}

# JWT Signing Key
jwt.secret=${JWT_SECRET:your_256_bit_secret_key_here}