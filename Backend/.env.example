# PostgreSQL (Aiven) Database Configuration
DB_HOST=pg-xxxxxxxx-your-account.aivencloud.com
DB_PORT=16484
DB_NAME=defaultdb
DB_USERNAME=avnadmin
DB_PASSWORD=your_aiven_db_password_here

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Application Security & Administration
ADMIN_RESET_KEY=your_admin_reset_key_here
JWT_SECRET=your_base64_encoded_256_bit_jwt_secret_here